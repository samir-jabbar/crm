{
  "name": "@hanjing/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "owner:reset-password": "tsx --env-file-if-exists=.env src/cli/reset-owner-password.ts",
    "geo:download": "tsx --env-file-if-exists=.env src/cli/download-geo.ts"
  },
  "dependencies": {
    "@hanjing/shared": "*",
    "@hono/node-server": "^2.1.3",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "bowser": "^2.14.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "maxmind": "^5.0.7",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.3"
  }
}
