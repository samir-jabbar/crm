# Copy to .env for local development. All values are optional; defaults are shown.

# development | production | test
NODE_ENV=development

# HTTP port of the API (and of the built web app in production)
PORT=3000

# Where the database (app.db), the geo database and, later, uploads are stored
DATA_DIR=./data

# Origins allowed to send state-changing requests (comma-separated).
# Dev: the Vite dev server. Production: the public HTTPS address, e.g. https://orders.example.com
APP_ORIGIN=http://localhost:5173,http://localhost:3000

# Trust X-Forwarded-For (only when running behind your own reverse proxy, feature 009)
TRUST_PROXY=false

# Optional fixed first-launch setup code (min 8 chars). If unset, a random code is printed in the server log.
# SETUP_CODE=

# Optional path to the DB-IP Lite City database (default: $DATA_DIR/geo/dbip-city-lite.mmdb)
# GEO_DB_PATH=

# 005: registrations accepted per network origin per hour (default 5). Raise only for automated tests.
# REGISTRATIONS_PER_HOUR=5
