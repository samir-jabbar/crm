{
  "name": "hanjing-order-manager",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @hanjing/server\" \"npm run dev -w @hanjing/web\"",
    "build": "npm run build -w @hanjing/web",
    "start": "npm run start -w @hanjing/server",
    "test": "npm run test -w @hanjing/server && npm run test -w @hanjing/web",
    "test:e2e": "npm run test:e2e -w @hanjing/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
